# ── artist steward agent ──────────────────────────────────────────
# Copy to .env. NEVER commit .env.

PORT=8403
# Safe default: only same-host payments can reach the steward.
HOST=127.0.0.1
# Optional on loopback for local dev; REQUIRED for every non-loopback HOST.
# When set, POST /ask requires: Authorization: Bearer <token>
# payments/ must send the same secret after its integration update.
STEWARD_SERVICE_TOKEN=
# Must match payments/ so live agent-compute payment cannot degrade to mock.
PAYMENTS_MODE=dev
# auto (default) = real provider path; without keys the 0G adapter still reaches
#                  the meter, which holds the upstream key. This is the demo path.
# fake           = offline fake provider, no network at all (UI work, tests)
STEWARD_MODE=auto

# which provider/model the steward uses. Copy providers.example.json to
# providers.json to customise; the loader falls back to the example if absent.
PROVIDER_CONFIG=config/providers.json
PAYMENTS_URL=http://localhost:8402

# ── 0G Private Computer (the demo path) ───────────────────────────
# mainnet: https://router-api.0g.ai/v1
# testnet: https://router-api-testnet.integratenetwork.work/v1
ZEROG_NETWORK=testnet
ZEROG_API_KEY=
# Optional explicit URL; blank selects the ZEROG_NETWORK endpoint above.
ZEROG_BASE_URL=
# Compatibility default, not a live catalog assertion. Set 0gm-1.0 when required
# by the current prize/catalog, or another exact model confirmed by the operator.
ZEROG_MODEL=0gm-1.0-35b-a3b
ZEROG_TRUST_MODE=verified

# ── how the steward reaches inference ─────────────────────────────
# 0G only: x402-meter pays via payments/; direct uses ZEROG_API_KEY (local dev).
INFERENCE_TRANSPORT=x402-meter
METER_URL=http://localhost:8402/meter/v1/chat/completions
# Fixed charge per meter call; keep equal to payments/ PRICE_METER_USDC.
METER_PRICE_PER_CALL_USD=0.002

# Agent compute account ONLY — signs the x402 payment for each inference call.
# Both are required in live mode; never reused below for the fan payment.
HEDERA_AGENT_ACCOUNT_ID=
HEDERA_AGENT_PRIVATE_KEY=
HEDERA_NETWORK=hedera:testnet

# Demo fan payer ONLY — separate from the agent compute account above.
# Dev uses an explicit mock when these are blank. Live requires both and never
# silently falls back to mock or to HEDERA_AGENT_* credentials.
HEDERA_FAN_ACCOUNT_ID=
HEDERA_FAN_PRIVATE_KEY=
# Optional override; defaults to HEDERA_NETWORK.
HEDERA_FAN_NETWORK=hedera:testnet

# ── budgets (USD) ─────────────────────────────────────────────────
BUDGET_PER_REQUEST_USD=0.01
BUDGET_HOURLY_USD=0.05
BUDGET_TOTAL_USD=5

# ── other providers, only if you want to prove portability ────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── fictional artist fixture (replace only after verified activation) ─────
ARTIST_FILE=data/artist.json
