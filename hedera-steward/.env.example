# Copy to .env (git-ignored) or use --env-file / STEWARD_ACCOUNTS_ENV. Names only — never commit values.
HEDERA_NETWORK=hedera:testnet
HEDERA_MIRROR_NODE=https://testnet.mirrornode.hedera.com

# Role accounts (teammate funding the EVM alias auto-creates the 0.0.N account; ACCOUNT_ID may stay empty)
FORK_DEMO_FAN_EVM_ADDRESS=
FORK_DEMO_FAN_ACCOUNT_ID=
FORK_DEMO_ARTIST_EVM_ADDRESS=
FORK_DEMO_ARTIST_ACCOUNT_ID=
FORK_DEMO_COMPUTE_EVM_ADDRESS=
FORK_DEMO_COMPUTE_ACCOUNT_ID=
FORK_DEMO_COMPUTE_PRIVATE_KEY=
FORK_DEMO_METER_EVM_ADDRESS=
FORK_DEMO_METER_ACCOUNT_ID=

# Optional explicit overrides (win over FORK_DEMO_*)
STEWARD_ACCOUNT_ID=
STEWARD_PRIVATE_KEY=
ARTIST_ACCOUNT_ID=
# Utkarsh's original names (lowest priority)
ACCOUNT_ID=
PRIVATE_KEY=

# Split (basis points, must sum to 10000)
STEWARD_ARTIST_BPS=9631
STEWARD_COMPUTE_BPS=369

# LLM brain for `agent` mode
ZEROG_API_KEY=
ZEROG_API_KEY_FILE=
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
