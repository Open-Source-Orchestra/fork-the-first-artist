# Rabdi testnet only, chain 7794095. Copy to ignored claims/.env.
# Dedicated server test wallet funded with tGLM; never use an artist wallet key.
ARKIV_PRIVATE_KEY=
# Obtain from https://hub.arkiv.network/access-keys ; keep server-side.
ARKIV_ACCESS_KEY=
# Separate 32-byte random encryption secret, encoded as 64 hex characters.
# Generate locally and back up securely. Losing it makes private records unreadable.
ARKIV_ENCRYPTION_KEY=
# Choose one stable namespace per environment; changing it hides old records.
ARKIV_NAMESPACE=oso-mumbai-demo
# Entity lifetime; invitation validity is separately limited to 1–72 hours.
ARKIV_RETENTION_DAYS=30
