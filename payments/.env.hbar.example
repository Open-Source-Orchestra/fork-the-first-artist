# ── payments service — native HBAR rail ───────────────────────────
# Same service as .env.example, priced in native HBAR instead of USDC:
# no token association, no USDC/Circle faucet — any funded testnet account pays.
# Copy to .env (or let scripts/live-e2e.sh generate one). NEVER commit .env.

PAYMENTS_MODE=dev
PORT=8402

# ── Hedera ────────────────────────────────────────────────────────
HEDERA_NETWORK=hedera:testnet
# x402.org facilitator advertises hedera:testnet exact (feePayer 0.0.9185802)
FACILITATOR_URL=https://x402.org/facilitator
# 0.0.0 = native HBAR in @x402/hedera 2.30 (amounts are tinybars, 8 decimals)
HEDERA_ASSET=0.0.0
HEDERA_ASSET_DECIMALS=8

# artist payout account — receives 96.31% (forwarded by the steward when ASK_PAYEE=steward)
HEDERA_ARTIST_ACCOUNT_ID=
# the artist's steward/compute account — receives the fan payment (ASK_PAYEE=steward),
# pays the inference meter, forwards the artist share, keeps 3.69% for 0G compute
HEDERA_COMPUTE_ACCOUNT_ID=
# distinct meter-operator recipient — required in live, no compute-to-self payments
HEDERA_METER_ACCOUNT_ID=
HEDERA_AGENT_PRIVATE_KEY=
HCS_SPEND_TOPIC_ID=

# artist = fan pays the artist directly (split is a preview only)
# steward = fan pays the artist's steward, which executes the split on-chain
ASK_PAYEE=steward

# ── split (basis points, must total 10000) ────────────────────────
SPLIT_ARTIST_BPS=9631
SPLIT_AGENT_BPS=369

# ── prices (asset units = HBAR) ───────────────────────────────────
# fan → steward, per question
PRICE_ASK=1
# steward → meter, per inference call
PRICE_METER=0.01

# ── budgets at the meter, in asset units (HBAR here; names kept for compat) ──
BUDGET_TOTAL_USD=10
BUDGET_HOURLY_USD=1
BUDGET_MAX_PER_CALL_USD=0.05

# ── upstream inference ────────────────────────────────────────────
UPSTREAM_BASE_URL=https://router-api.0g.ai/v1
UPSTREAM_API_KEY=
UPSTREAM_MODEL=0gm-1.0-35b-a3b
UPSTREAM_TRUST_MODE=verified

STEWARD_URL=http://localhost:8403
STEWARD_SERVICE_TOKEN=
